#!/bin/bash

# Update package lists
echo "Updating package lists..."
sudo apt update

# List upgradeable packages with "beta" in their name
echo "Listing upgradeable 'beta' packages..."
upgradeable_packages=$(apt list --upgradeable 2>/dev/null | grep "beta")

if [[ -z "$upgradeable_packages" ]]; then
  echo "No upgradeable packages containing 'beta' found."
else
  echo "The following 'beta' packages are upgradeable:"
  echo "$upgradeable_packages"
fi

# Function to handle options for each package
handle_package() {
  local pkg_name=$1
  while true; do
    echo "Options for package '$pkg_name':"
    echo "1) Mark as hold"
    echo "2) Show package details"
    echo "3) Skip to next package"
    echo "4) Quit"
    read -p "Choose an option: " option < /dev/tty
    case $option in
      1 )
        sudo apt-mark hold "$pkg_name"
        echo "'$pkg_name' marked as hold."
        break
        ;;
      2 )
        apt show "$pkg_name"
        ;;
      3 )
        break
        ;;
      4 )
        exit 0
        ;;
      * )
        echo "Invalid option. Please choose 1, 2, 3, or 4."
        ;;
    esac
  done
}

# Iterate over each "beta" package and provide options
if [[ -n "$upgradeable_packages" ]]; then
  while IFS= read -r package < /dev/tty; do
    pkg_name=$(echo "$package" | awk -F/ '{print $1}')
    handle_package "$pkg_name"
  done <<< "$upgradeable_packages"
fi

# Manage held packages
while true; do
  echo "Do you want to manage held packages?"
  echo "1) List held packages"
  echo "2) Release a held package"
  echo "3) Quit"
  read -p "Choose an option: " manage_option < /dev/tty
  case $manage_option in
    1 )
      held_packages=$(apt-mark showhold)
      if [[ -z "$held_packages" ]]; then
        echo "No packages are currently held."
      else
        echo "Currently held packages:"
        echo "$held_packages"
      fi
      ;;
    2 )
      if [[ -z "$held_packages" ]]; then
        echo "No packages are currently held."
      else
        echo "$held_packages"
        read -p "Enter the name of the package to release: " release_pkg < /dev/tty
        sudo apt-mark unhold "$release_pkg"
        echo "'$release_pkg' has been released."
      fi
      ;;
    3 )
      break
      ;;
    * )
      echo "Invalid option. Please choose 1, 2, or 3."
      ;;
  esac
done

echo "Script finished."
